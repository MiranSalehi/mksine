{
    "private": true,
    "type": "module",
    "scripts": {
        "dev:styles": "npx @tailwindcss/cli -i resources/css/index.css -o resources/dist/mksine.css --watch",
        "dev:scripts": "node bin/build.js --dev",
        "dev:theme": "node bin/watch-theme-publish.js",
        "build:styles": "npx @tailwindcss/cli -i resources/css/index.css -o resources/dist/mksine.css --minify",
        "build:scripts": "node bin/build.js",
        "dev": "node bin/filament-assets.js && npm-run-all --parallel dev:*",
        "build": "npm-run-all build:* && node bin/theme-publish.js && node bin/filament-assets.js"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.0.0",
        "@tailwindcss/typography": "^0.5.16",
        "esbuild": "^0.19.2",
        "npm-run-all": "^4.1.5",
        "prettier": "^2.7.1"
    },
    "dependencies": {
        "ckeditor5": "^47.3.0",
        "sortablejs": "^1.15.2"
    }
}
