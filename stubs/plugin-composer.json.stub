{
    "name": "mks-plugins/{{ id }}",
    "description": "{{ description }}",
    "type": "mks-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "{{ author }}"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "{{ escapedNamespace }}\\": "src/"
        }
    },
    "extra": {
        "mks-plugin": {
            "class": "{{ escapedNamespace }}\\{{ className }}"
        }
    }
}

